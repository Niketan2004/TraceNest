# ==============================================================================
# TraceNet Frontend Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dev Server & Network Binding
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5173

# ------------------------------------------------------------------------------
# 2. REST API Base URL
# ------------------------------------------------------------------------------
# In local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# In production, point to your API gateway:
# VITE_API_BASE_URL=https://api.tracenest.app/api/v1

