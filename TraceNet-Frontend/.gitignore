# ==============================================================================
# TraceNet Frontend .gitignore
# ==============================================================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/
.turbo/
build/

# Environment files
.env
.env.*
!.env.example
*.local
.env.local
.env.*.local
.dev.vars

# Cloudflare / Wrangler
.wrangler/

# Cache & Diagnostics
.eslintcache
.stylelintcache
*.tsbuildinfo

# IDEs & Editor configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
