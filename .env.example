# ==============================================================================
# TraceNest Master Environment Configuration (.env.example)
# Copy this file to .env or place corresponding .env in TraceNest-Backend/ & TraceNet-Frontend/
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Backend Port & Network
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tracenest
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# JWT Authentication
APP_JWT_SECRET=VGhpcyBpcyBhIHZlcnkgc2VjdXJlIHNlY3JldCBrZXkgZm9yIEpXVA==
APP_JWT_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=2592000000

# Cloudinary CDN (Images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Dispatch
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Twilio SMS Dispatch
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend Configuration
HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

