# ==============================================================================
# TraceNest Backend Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual secrets.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Local development URL (or jdbc:postgresql://db:5432/tracenest in Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tracenest
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# 3. JWT Security & Token Lifetimes
# ------------------------------------------------------------------------------
# Generate a 256-bit Base64 encoded secret key for HMAC-SHA256
APP_JWT_SECRET=VGhpcyBpcyBhIHZlcnkgc2VjdXJlIHNlY3JldCBrZXkgZm9yIEpXVA==
# Access token validity: 15 minutes (900,000 ms)
APP_JWT_EXPIRATION_MS=900000
# Refresh token validity: 30 days (2,592,000,000 ms)
APP_JWT_REFRESH_EXPIRATION_MS=2592000000

# ------------------------------------------------------------------------------
# 4. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
# Sign up at https://cloudinary.com/ for free media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 5. Email Dispatch (Spring Mail / SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ------------------------------------------------------------------------------
# 6. SMS Alerts (Twilio)
# ------------------------------------------------------------------------------
# Sign up at https://twilio.com/ for SMS alerting
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 7. Application Logging
# ------------------------------------------------------------------------------
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO

