# ==============================================================================
# TraceNest Backend .gitignore
# ==============================================================================

# Compiled class files
*.class

# Log files
*.log
logs/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# Spring Boot devtools restart marker
.reload-trigger

# Environment variables & secrets
.env
.env.*
!.env.example
*.env
*.env.local

# IDEs & Tooling
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated
.springBeans
.sts4-cache/
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini
