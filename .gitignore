# ==============================================================================
# TraceNest Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.local
*.env.*.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Datasets & Large Binary Scaffolding
# ------------------------------------------------------------------------------
/datasets/**
!/datasets/.gitkeep

# ------------------------------------------------------------------------------
# 3. Java & Maven Artifacts (Backend)
# ------------------------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
dist-ssr/
**/.output/
.output/
**/.nitro/
.nitro/
**/.vinxi/
.vinxi/
**/.tanstack/
.tanstack/
.turbo/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Visual Studio / Windows
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
